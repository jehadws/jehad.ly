{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*":            ["./src/*"],
      "@src/*":         ["./src/*"],
      "@components/*":  ["./src/components/*"],
      "@scenes/*":      ["./src/scenes/*"],
      "@hooks/*":       ["./src/hooks/*"],
      "@assets/*":      ["./src/assets/*"],
      "@contexts/*":    ["./src/contexts/*"],
      "@helpers/*":     ["./src/helpers/*"],
      "@app-types/*":   ["./src/types/*"],
      "@styles/*":      ["./src/styles/*"],
      "@functions/*":   ["./src/styles/functions/*"],
      "@constants/*":   ["./src/constants/*"],
      "@data/*":        ["./src/data/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "_gatsby"]
}
